# ================================================================
#  .env.example  —  Copy to .env and edit before first run
#  AI Study Buddy — Kathford BSc CSIT
# ================================================================

# ── Local LLM (Ollama — recommended) ────────────────────────────
# Install: https://ollama.com  then run: ollama pull qwen2.5:7b
# For better quality on your 16GB GPU: ollama pull qwen2.5:14b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=900

# To switch to vllm instead, change only LLM_BASE_URL:
# LLM_BASE_URL=http://localhost:8000/v1

# ── Embedding Model ──────────────────────────────────────────────
# Downloaded once (~400MB) to ~/.cache/huggingface on first run
# MUST match the model used during ingest -- changing requires re-ingest
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# ── ChromaDB (local persistent — no Docker required) ─────────────
# Leave CHROMA_HOST commented out to use local file storage (default)
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# CHROMA_SSL=false
CHROMA_PATH=VectorStore/chroma_db

# ── Retrieval Settings ───────────────────────────────────────────
TOP_K=10
RERANK_TOP=4

# Chunk settings (changing these requires full re-ingest)
CHUNK_SIZE=600
CHUNK_OVERLAP=80
